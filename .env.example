# Copy this file to .env.local and fill in the values you have.
# Every one of these is optional — the site works and builds fine with
# none of them set; each integration below simply stays inert until its
# variable is present.

# The production domain, used by metadata, sitemap.xml, robots.txt, and
# JSON-LD structured data. Defaults to https://avanlog.orynticlabs.com if unset.
NEXT_PUBLIC_SITE_URL=https://avanlog.orynticlabs.com

# Google Search Console: Settings → Ownership verification → HTML tag →
# copy only the "content" value (not the whole <meta> tag).
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4: Admin → Data Streams → your web stream →
# Measurement ID (format: G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity: Settings → Overview → Project ID (format: a short
# alphanumeric string, not a URL).
NEXT_PUBLIC_CLARITY_ID=

# --- Contact form → OryCMS lead intake (src/app/api/leads/route.ts) ---
# NOT optional in the same sense as the above: until both of these are
# set, the contact form will validate submissions correctly but fail to
# deliver them (it returns an honest error to the visitor rather than a
# fake success). Server-only — never exposed to the browser.

# The OryCMS admin endpoint that receives Avanlog leads. Confirm the
# exact path with whoever owns orynticlabs.com/admin — this is a
# placeholder until that's confirmed.
LEADS_FORWARD_URL=https://orynticlabs.com/admin/api/avanlog-leads

# Shared secret sent as the x-avanlog-api-key header on every forwarded
# lead, so OryCMS can verify requests actually came from this site.
# Generate a long random value and set the same one on the OryCMS side.
LEADS_API_SECRET=
